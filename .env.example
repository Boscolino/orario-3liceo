# Copia in ".env" e adatta. Nessuna password/credenziale qui dentro.

CLASS_SLUG=3liceo
CLASS_NAME=3 Liceo
SITE_HOST=orario.rainerum.delugan.net
# minimo di settimane controllate sempre; poi si guarda avanti finché il
# sito ha settimane pubblicate (fino a MAX_WEEKS)
CHECK_WEEKS=4
MAX_WEEKS=45
TIMEZONE=Europe/Rome
# ora del controllo "mattina" (notifica sempre) e ore dei controlli
# successivi (notificano solo se ci sono variazioni) — usate dal
# comando "check auto" lanciato dal cron
MORNING_HOUR=6
DAYTIME_HOURS=7,8,9,10,11,12,13,16,18,21
CALENDAR_NAME=📚 Scuola
SCHOOL_VENUE=Scuola Salesiani Rainerum, Piazza Domenicani 15, 39100 Bolzano

# Notifiche ntfy (vuoto = disattivate, solo log).
# Scegli un nome lungo e non indovinabile: chi lo conosce può leggere le notifiche.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
