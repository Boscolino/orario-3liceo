# Copia in ".env" e adatta. Nessuna password/credenziale qui dentro.

CLASS_SLUG=3liceo
CLASS_NAME=3 Liceo
SITE_HOST=orario.rainerum.delugan.net
# minimo di settimane controllate sempre; poi si guarda avanti finché il
# sito ha settimane pubblicate (fino a MAX_WEEKS)
CHECK_WEEKS=4
MAX_WEEKS=45
TIMEZONE=Europe/Rome
CALENDAR_NAME=📚 Scuola

# Notifiche ntfy (vuoto = disattivate, solo log).
# Scegli un nome lungo e non indovinabile: chi lo conosce può leggere le notifiche.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
